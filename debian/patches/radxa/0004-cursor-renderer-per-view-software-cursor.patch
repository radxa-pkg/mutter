diff --git a/src/backends/meta-stage.c b/src/backends/meta-stage.c
index 66b5aed5d..740f8c2bd 100644
--- a/src/backends/meta-stage.c
+++ b/src/backends/meta-stage.c
@@ -40,6 +40,7 @@ typedef struct _MetaOverlayViewState
 {
   graphene_rect_t painted_rect;
   gboolean has_painted_rect;
+  gboolean has_hw_cursor;
 } MetaOverlayViewState;
 
 struct _MetaOverlay
@@ -169,8 +170,10 @@ meta_overlay_paint (MetaOverlay         *overlay,
       CLUTTER_PAINT_FLAG_NO_CURSORS);
   if (should_paint_any)
     {
+      gboolean view_has_hw_cursor = view_state && view_state->has_hw_cursor;
+
       should_paint =
-        (overlay->texture && overlay->is_visible) ||
+        (overlay->texture && overlay->is_visible && !view_has_hw_cursor) ||
         (clutter_paint_context_get_paint_flags (paint_context) &
          CLUTTER_PAINT_FLAG_FORCE_CURSORS);
     }
@@ -436,6 +439,7 @@ queue_redraw_for_cursor_overlay (MetaStage   *stage,
 
       if (overlay->is_visible &&
           overlay->texture &&
+          !view_state->has_hw_cursor &&
           !(clutter_stage_view_get_default_paint_flags (view) &
             CLUTTER_PAINT_FLAG_NO_CURSORS) &&
           !meta_stage_view_is_cursor_overlay_inhibited (META_STAGE_VIEW (view)))
@@ -495,6 +499,20 @@ meta_overlay_set_visible (MetaOverlay *overlay,
   queue_redraw_for_cursor_overlay (overlay->stage, overlay);
 }
 
+void
+meta_overlay_set_view_has_hw_cursor (MetaOverlay      *overlay,
+                                     ClutterStageView *view,
+                                     gboolean          has_hw_cursor)
+{
+  MetaOverlayViewState *view_state = ensure_view_state (overlay, view);
+
+  if (view_state->has_hw_cursor == has_hw_cursor)
+    return;
+
+  view_state->has_hw_cursor = has_hw_cursor;
+  queue_redraw_for_cursor_overlay (overlay->stage, overlay);
+}
+
 MetaStageWatch *
 meta_stage_watch_view (MetaStage           *stage,
                        ClutterStageView    *view,
