@@ -424,6 +425,10 @@ meta_cursor_renderer_native_update_cursor (MetaCursorRenderer *cursor_renderer,
                                                      NULL);
             }
         }
+
+      meta_overlay_set_view_has_hw_cursor (meta_cursor_renderer_get_stage_overlay (cursor_renderer),
